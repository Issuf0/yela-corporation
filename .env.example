# ---------------------------------------------------------------------------
# YELA Corporation — variáveis de ambiente
# Copiar para .env.local (desenvolvimento) ou configurar no painel da Vercel
# (produção). NUNCA colocar valores reais neste ficheiro nem no repositório.
# ---------------------------------------------------------------------------

# --- Servidor (função /api/contact) — nunca chegam ao browser ---------------

# Chave da API Resend (https://resend.com/api-keys). Obrigatória em produção.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remetente dos emails. Tem de pertencer a um domínio verificado na Resend
# (recomendado: subdomínio de envio, ex.: mail.exemplo.co.mz).
CONTACT_FROM_EMAIL="YELA Corporation <contacto@mail.exemplo.co.mz>"

# Endereço interno da YELA que recebe cada novo contacto. Obrigatório.
YELA_CONTACT_EMAIL=contacto@exemplo.co.mz

# Opcional. Só definir depois de aprovado o encaminhamento de contactos para a
# Learn Code. Se estiver vazio/ausente, não é enviada nenhuma cópia.
# LEARN_CODE_CONTACT_EMAIL=parcerias@exemplo-learncode.co.mz

# Opcional (true/false, por omissão false). Envia confirmação de receção ao
# visitante. Requer domínio verificado na Resend.
# CONTACT_ACK_ENABLED=true

# Apenas desenvolvimento/testes: "mock" regista os emails na consola em vez
# de os enviar. Ignorado em produção.
# CONTACT_SENDER=mock

# --- Build (usadas pelo Vite em tempo de compilação) ------------------------

# URL pública de produção, sem barra final. Activa canonical, og:url,
# og:image e sitemap.xml. Deixar vazio até o domínio estar confirmado.
# SITE_URL=https://www.exemplo.co.mz

# Endereço público para pedidos de privacidade, mostrado em /privacidade.
# VITE_PRIVACY_CONTACT_EMAIL=privacidade@exemplo.co.mz
